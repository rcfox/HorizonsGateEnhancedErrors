<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
    </startup>
    <runtime>
        <!-- EnhancedErrors: loads EnhancedErrors.dll before the game starts. -->
        <appDomainManagerAssembly value="EnhancedErrors, Version=@VERSION@, Culture=neutral, PublicKeyToken=null" />
        <appDomainManagerType value="EnhancedErrors.Manager" />
    </runtime>
</configuration>
